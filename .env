DEBUG=oidc-provider:*
SESSION_SECRET=<your-session-secret>
DID_ID=<your-verifier-did-id>
TREC_ID=<trec-app-id>
CLIENT_SECRET=<trec-app-client-secret>
PROVIDER_URL=<your-oidc-provider-url>
COOKIES_KEY=<your-key-for-signing-cookies>
AUTH_ENDPOINT=<your-auth-endpoint>
TOKEN_ENDPOINT=<your-token-endpoint>
SCOPES=offline_access openid profile email profile.trec.me
TREC_REDIRECT_URI=<trec-redirect-uri>
AT_TTL=<access-token-duration>
ID_TTL=<id-token-duration>
RT_TTL=<refresh-token-duration>
CORS_ORIGIN=<trec-app-url>
PORT=<your-oidc-provider-port>
VERIFIER_LABEL=<your-verifier-label>
VERIFIER_WALLET_ID=<your-verifier-wallet-id>
VERIFIER_WALLET_KEY=<your-verifier-wallet-key>
VERIFIER_ENDPOINT=<your-verifier-endpoint>
VERIFIER_COSMOS_SEED=<your-verifier-cosmos-seed>
VERIFIER_PORT=<your-verifier-port>
CHEQD_NETWORK=<mainnet-or-testnet>
CREDENTIAL_DEFINITION_ID=<your-credential-definition-id>
