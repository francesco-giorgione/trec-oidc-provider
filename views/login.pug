
block content
  head
    script(src="https://cdn.jsdelivr.net/npm/jwt-decode@3.1.2/build/jwt-decode.min.js")

  body
    p#text #{url}
    button#tornaHome(style='display: none') Torna alla home

  script.
    (async () => {
      try {
        const oobId = '#{oob_id}'
        const uid = '#{u_id}'
        const url = `http://localhost:5000/interaction/${uid}/login`;

        const response = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({oob_id: oobId}),
        });

        document.body.innerHTML = await response.text();
      } catch (error) {
        console.error('Errore durante la richiesta:', error.message)

        // Il messaggio visualizzato è lo stesso indipendentemente dal tipo di errore verificatosi
        document.getElementById('text').innerText = 'Si è verificato un errore: la verifica della prova potrebbe ' +
                'essere fallita'

        document.getElementById('tornaHome').addEventListener('click', function () {
          window.location.href = 'http://localhost:4200';
        });
        document.getElementById('tornaHome').style.display = 'block';
      }
    })();